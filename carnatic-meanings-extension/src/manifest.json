{
  "manifest_version": 3,
  "name": "Carnatic Meanings for YouTube",
  "version": "0.1.0",
  "description": "Shows the lyrics and meaning of Carnatic songs in the YouTube sidebar, highlighted line by line as the song plays.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["lib/match.js", "lib/cues.js", "content.js"],
      "css": ["sidebar.css"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": { "default_title": "Carnatic Meanings — settings", "default_popup": "options.html" },
  "icons": { "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
